<section id="packages">

    <div id="top-content">
        <h1 class="section-title">Popular Packages</h1>
        <!-- <img src="img/global/green-icon.svg" alt="part of a green outline"> -->
        <div id="package-button-container">
            <button id="left-arrow"><img src="img/packages/arrow-left.svg" alt="arrow left"></button>
            <button id="right-arrow"><img src="img/packages/arrow-right.svg" alt="arrow right"></button>
        </div>
    </div>


    <ul id="package-card-container">
        <li class="package-card" id="card-1">
            <img src="img/packages/card1.png" alt="two women having conversation" class="img-scaler">
            <p>The basic package to start your promotion</p>
            <ul>
                <li><img src="img/packages/user-1.jpg" alt="user icon"></li>
                <li><img src="img/packages/user-3.jpg" alt="user icon"></li>
                <li><img src="img/packages/user-2.jpg" alt="user icon"></li>
            </ul>
            <h4>200k+ users</h4>
            <h3>$89.00</h3>
        </li>

        <li class="selected package-card" id="card-2">
            <img src="img/packages/card3.png" alt="a man presenting on a laptop to another man" class="img-scaler">
            <p>The standard package to grow your business</p>
            <ul>
                <li><img src="img/packages/user-5.jpg" alt="user icon"></li>
                <li><img src="img/packages/user-3.jpg" alt="user icon"></li>
                <li><img src="img/packages/user-4.jpg" alt="user icon"></li>
            </ul>
            <h4>140k+ users</h4>
            <h3>$109.00</h3>
        </li>

        <li class="package-card" id="card-3">
            <img src="img/packages/card2.png" alt="two women discussing the contents of a document" class="img-scaler">
            <p>The premium package to boost your promotion</p>
            <ul>
                <li><img src="img/packages/user-4.jpg" alt="user icon"></li>
                <li><img src="img/packages/user-2.jpg" alt="user icon"></li>
                <li><img src="img/packages/user-5.jpg" alt="user icon"></li>
            </ul>
            <h4>99k+ users</h4>
            <h3>$149.00</h3>
        </li>
    </ul>
</section>